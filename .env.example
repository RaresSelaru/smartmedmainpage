NEXT_PUBLIC_GRILE_URL=https://grile.smartmed.ro
NEXT_PUBLIC_SITE_URL=https://smartmed.ro

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Social login is enabled in the interface only after the matching provider is
# configured in Supabase Auth. Provider secrets stay server-side.
AUTH_GOOGLE_ENABLED=false
AUTH_FACEBOOK_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# Administrative CMS runtime policy. Hosted/non-local environments must use true.
CMS_REQUIRE_ADMIN_MFA=true
CMS_MAX_IMAGE_BYTES=6291456
CMS_MAX_IMAGE_WIDTH=4096
CMS_MAX_IMAGE_HEIGHT=4096

# Configure these redirect URLs in Supabase Auth:
# http://localhost:3000/auth/callback
# http://127.0.0.1:3000/auth/callback
# http://[::1]:3000/auth/callback
# https://smartmedmainpage.vercel.app/auth/callback
# https://smartmed.ro/auth/callback
# https://www.smartmed.ro/auth/callback
#
# Google Cloud and Meta receive the Supabase Auth callback, not the app callback:
# http://127.0.0.1:54321/auth/v1/callback
# https://<project-ref>.supabase.co/auth/v1/callback

# Future integrations. Server secrets must never use the NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional evaluation emails. Keep the API key server-only. The sender
# must use a domain verified in Resend, for example:
# RESEND_FROM_EMAIL=SmartMed Academy <programari@smartmed.ro>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Destination for internal alerts about centre and event registrations. This
# must be a plain inbox address and is intentionally separate from Reply-To.
REGISTRATIONS_STAFF_EMAIL=

# Server-only privileged key used solely to claim and complete transactional
# email outbox records. Prefer the current sb_secret_ key format. Never expose
# either key with a NEXT_PUBLIC_ prefix. The service-role name is legacy-only.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends this value as `Authorization: Bearer <CRON_SECRET>` to the
# protected registration email retry worker. Use a random server-only secret
# of at least 16 characters.
# The checked-in Vercel Hobby schedule retries failed deliveries once per day.
# Initial registration emails are still sent immediately by the form action.
# On Vercel Pro, this retry schedule can safely be increased to every 15 minutes.
CRON_SECRET=
