{
  "name": "smartmed-main-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": {
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:unit",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.ts\"",
    "test:db": "supabase test db --local supabase/tests",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e",
    "admin:provision:local": "tsx --env-file-if-exists=.env.admin.local scripts/admin-provision.ts local:provision",
    "admin:hosted:invite": "tsx --env-file-if-exists=.env.admin.local scripts/admin-provision.ts hosted:invite",
    "admin:hosted:grant": "tsx --env-file-if-exists=.env.admin.local scripts/admin-provision.ts hosted:grant",
    "admin:hosted:grant-super-admin": "tsx --env-file-if-exists=.env.admin.local scripts/admin-provision.ts hosted:grant-super-admin",
    "admin:hosted:verify": "tsx --env-file-if-exists=.env.admin.local scripts/admin-provision.ts hosted:verify",
    "admin:hosted:revoke": "tsx --env-file-if-exists=.env.admin.local scripts/admin-provision.ts hosted:revoke"
  },
  "dependencies": {
    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@lexical/utils": "0.48.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lexical": "0.48.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3",
    "styled-components": "^6.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "tsx": "4.22.5",
    "typescript": "^5"
  }
}
