# Copy to .env.admin.local and keep that real file untracked.
# Never reuse local credentials in a hosted project.

# Local-only administrator provisioning
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DISPLAY_NAME=
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_ADMIN_KEY=
LOCAL_SUPABASE_PUBLISHABLE_KEY=
LOCAL_APP_URL=http://127.0.0.1:3000

# Hosted operator workflow
ADMIN_BOOTSTRAP_ENVIRONMENT=staging
ADMIN_BOOTSTRAP_EXECUTE=false
BOOTSTRAP_ADMIN_EMAIL=
EXPECTED_SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_OPERATOR_SECRET_KEY=
# Exact existing password-setting flow, for example:
# https://smartmed.ro/cont?mode=parola-noua
ADMIN_INVITE_REDIRECT_URL=
ADMIN_OPERATOR_REFERENCE=
ADMIN_CHANGE_REASON=
